# Copy to .env for local runs (never commit .env). Not used on Cloud Foundry.
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=
HANA_SCHEMA=MFRS18_CORE
HANA_TABLE=FINANCIAL_DATA
# Optional: column(s) for stable paging on the data screen, e.g. ID
DATA_ORDER_BY=
# Skip XSUAA checks locally (ignored when running on Cloud Foundry)
LOCAL_DEV_NO_AUTH=1
